<Window x:Class="ClipStack.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:ClipStack.App.Controls"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="ClipStack · 剪贴板历史" Style="{StaticResource {x:Type Window}}" Width="500" Height="660" MinWidth="380" MinHeight="400"
 Icon="Assets/clipstack.ico" WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
 PreviewKeyDown="OnPreviewKeyDown" Deactivated="OnDeactivated" Closing="OnClosing">
 <!-- 外框与原生阴影统一使用直角，避免不透明窗口底色露在装饰圆角之外。 -->
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0" /></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="FontFamily" Value="Segoe MDL2 Assets" /><Setter Property="FontSize" Value="14" /><Setter Property="Padding" Value="7" />
   <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="Focusable" Value="False" />
  </Style>
 </Window.Resources>
 <Border BorderBrush="#AAB8CB" BorderThickness="1" Background="#F5F7FA">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="Auto" /><RowDefinition Height="{DynamicResource PanelFilterHeight}" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Border Background="White" BorderBrush="#E2E7EE" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitleDrag">
   <Grid Margin="16,0,8,0">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77F;" Foreground="{StaticResource Accent}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
     <TextBlock Text="ClipStack" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button Style="{StaticResource IconButton}" Content="&#xE713;" Click="OnSettings" ToolTip="设置" AutomationProperties.Name="设置" />
     <Button Style="{StaticResource IconButton}" Content="&#xE712;" Click="OnCleanup" ToolTip="更多：暂停、清理、退出" AutomationProperties.Name="更多操作" />
     <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="OnHide" ToolTip="隐藏窗口（Esc）" AutomationProperties.Name="隐藏窗口" Margin="4,0,0,0" />
    </StackPanel>
   </Grid>
   </Border>
   <Grid Grid.Row="1" Margin="{DynamicResource PanelSearchMargin}">
    <TextBox x:Name="SearchBox" Height="{DynamicResource PanelSearchHeight}" Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}" Padding="34,0,12,0" AutomationProperties.Name="搜索复制内容" />
    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" Foreground="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
    <TextBlock Text="搜索历史…" Foreground="{StaticResource Muted}" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding QueryText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </Grid>
   <DockPanel Grid.Row="2" Margin="{DynamicResource PanelFilterMargin}" VerticalAlignment="Center">
    <TextBlock DockPanel.Dock="Right" Text="{Binding ResultLabel}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
    <StackPanel x:Name="FilterOptions" Orientation="Horizontal" ToolTip="左右方向键切换分类（搜索框为空时）">
     <RadioButton Content="全部" Style="{StaticResource NavButton}" GroupName="Filter" Tag="All" IsChecked="True" Checked="OnFilterChanged" />
     <RadioButton Content="文本" Style="{StaticResource NavButton}" GroupName="Filter" Tag="Text" Checked="OnFilterChanged" />
     <RadioButton Content="图片" Style="{StaticResource NavButton}" GroupName="Filter" Tag="Image" Checked="OnFilterChanged" />
     <RadioButton Content="收藏" Style="{StaticResource NavButton}" GroupName="Filter" Tag="Favorites" Checked="OnFilterChanged" />
    </StackPanel>
   </DockPanel>
   <Grid Grid.Row="3" Margin="{DynamicResource PanelListMargin}">
    <ListBox x:Name="HistoryList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Background="Transparent" BorderThickness="0" Padding="0"
     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
     ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1"
     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" MouseDoubleClick="OnItemDoubleClick" AutomationProperties.Name="剪贴板历史列表">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Ink}" /><Setter Property="Margin" Value="{DynamicResource PanelCardMargin}" /><Setter Property="Padding" Value="{DynamicResource PanelCardPadding}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
       <Border x:Name="Card" Background="{StaticResource Surface}" BorderThickness="1" BorderBrush="{StaticResource Line}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#B8C5D6" /></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}" /><Setter TargetName="Card" Property="Background" Value="#F3F7FF" /></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
     </Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <DockPanel LastChildFill="True" Margin="{DynamicResource PanelHeaderMargin}">
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" Click="OnCopy" ToolTip="复制" AutomationProperties.Name="复制这条记录" />
        <Button Click="OnFavorite" ToolTip="{Binding FavoriteLabel}" AutomationProperties.Name="{Binding FavoriteLabel}">
         <Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Content" Value="&#xE734;" /><Style.Triggers>
          <DataTrigger Binding="{Binding Entry.Favorite}" Value="True"><Setter Property="Content" Value="&#xE735;" /><Setter Property="Foreground" Value="{StaticResource Accent}" /></DataTrigger>
         </Style.Triggers></Style></Button.Style>
        </Button>
        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Click="OnDelete" ToolTip="删除" AutomationProperties.Name="删除这条记录" />
       </StackPanel>
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="{StaticResource Muted}" />
        <TextBlock Text="{Binding TimeLabel}" FontSize="11" Foreground="{StaticResource Muted}" Margin="10,0,0,0" />
       </StackPanel>
      </DockPanel>
      <controls:InlineNoteEditor Grid.Row="2" Value="{Binding Entry.Note, Mode=OneWay}" Label="{Binding NoteLabel}"
       Visibility="{Binding FavoriteVisibility}" HorizontalAlignment="Left" Margin="{DynamicResource PanelNoteMargin}"
       Loaded="OnNoteEditorLoaded" EditingChanged="OnNoteEditingChanged" />
      <TextBlock Grid.Row="1" Text="{Binding Entry.Summary}" Visibility="{Binding TextVisibility}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="{DynamicResource PanelTextHeight}" LineHeight="{DynamicResource PanelLineHeight}" />
      <StackPanel Grid.Row="1" Visibility="{Binding ImageVisibility}">
       <Border Background="{StaticResource Raised}" CornerRadius="3" Height="{DynamicResource PanelImageHeight}" HorizontalAlignment="Left" MinWidth="150" MaxWidth="300"><Image Source="{Binding Thumbnail}" Stretch="Uniform" HorizontalAlignment="Left"
        Loaded="OnThumbnailLoaded" Unloaded="OnThumbnailUnloaded" DataContextChanged="OnThumbnailDataContextChanged" IsVisibleChanged="OnThumbnailVisibilityChanged" /></Border>
       <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource Muted}" Margin="{DynamicResource PanelImageDetailMargin}" />
      </StackPanel>
     </Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding EmptyVisibility}" Margin="20">
     <TextBlock Text="{Binding EmptyTitle}" FontSize="15" HorizontalAlignment="Center" />
     <TextBlock Text="{Binding EmptyDescription}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" LineHeight="22" />
    </StackPanel>
   </Grid>
   <Border Grid.Row="4" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,3,0,0" Padding="{DynamicResource PanelFooterPadding}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <DockPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" IsEnabled="{Binding HasSelection}">
       <Button Content="查看" Click="OnPreview" Padding="9,5" Background="Transparent" ToolTip="查看全文或大图（列表中按空格）" Margin="0,0,6,0" />
       <Button Content="粘贴 ↵" Click="OnPaste" Padding="12,5" Style="{StaticResource PrimaryButton}" />
      </StackPanel>
      <TextBlock Text="{Binding HotkeyLabel}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" ToolTip="全局呼出快捷键；↑↓ 选择，双击或 Enter 粘贴，Esc 隐藏" />
     </DockPanel>
     <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="{DynamicResource PanelStatusMargin}" />
    </Grid>
   </Border>
  </Grid>
 </Border>
</Window>
