<Window x:Class="ClipStack.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipStack 设置" Style="{StaticResource {x:Type Window}}" Width="550" Height="665" MinWidth="500" MinHeight="540"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False">
  <Grid Margin="28,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20"><TextBlock Text="设置" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="管理界面、快捷键、保存容量和隐私。" Foreground="{StaticResource Muted}" Margin="0,8,0,0" /></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
      <StackPanel>
        <TextBlock Text="主界面紧凑程度" Foreground="{StaticResource Muted}" Margin="0,0,0,7" />
        <StackPanel x:Name="DensityOptions" Orientation="Horizontal" AutomationProperties.Name="主界面紧凑程度">
          <RadioButton x:Name="CompactDensity" Content="紧凑" GroupName="Density" Style="{StaticResource NavButton}" />
          <RadioButton x:Name="StandardDensity" Content="标准" GroupName="Density" Style="{StaticResource NavButton}" />
          <RadioButton x:Name="ComfortableDensity" Content="宽松" GroupName="Density" Style="{StaticResource NavButton}" />
        </StackPanel>
        <TextBlock Text="调整留白及预览高度，保存后立即生效。" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,18" />
        <TextBlock Text="窗口位置" Foreground="{StaticResource Muted}" Margin="0,0,0,7" />
        <WrapPanel AutomationProperties.Name="窗口位置">
          <RadioButton x:Name="RememberPosition" Content="记住位置" GroupName="Position" Style="{StaticResource NavButton}" />
          <RadioButton x:Name="MousePosition" Content="跟随鼠标" GroupName="Position" Style="{StaticResource NavButton}" />
          <RadioButton x:Name="CenterPosition" Content="屏幕中间" GroupName="Position" Style="{StaticResource NavButton}" />
          <RadioButton x:Name="RightPosition" Content="屏幕右侧" GroupName="Position" Style="{StaticResource NavButton}" />
        </WrapPanel>
        <TextBlock Text="下次呼出时生效；记住位置模式首次在屏幕右侧显示。" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,8" />
        <CheckBox x:Name="ResetFilterBox" Content="呼出时默认切换到「全部」" />
        <TextBlock Text="默认开启；关闭后保留上次分类，搜索关键词保留。" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18" />
        <CheckBox x:Name="ResetListBox" Content="激活窗口时，滚动至顶部并选中首条" />
        <TextBlock Text="作用于当前搜索和分类下的记录，默认开启。" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,18" />
        <CheckBox x:Name="HideAfterCopyBox" Content="复制后隐藏窗口" />
        <TextBlock Text="复制成功后自动隐藏，适用于复制按钮和 Ctrl+C，默认开启。" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18" />
        <CheckBox x:Name="TrayIconBox" Content="显示托盘图标" />
        <TextBlock Text="保存后立即生效；关闭后仍可通过快捷键呼出。" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18" />
        <TextBlock Text="全局快捷键" Foreground="{StaticResource Muted}" Margin="0,0,0,7" />
        <TextBox x:Name="HotkeyBox" AutomationProperties.Name="全局快捷键" />
        <TextBlock Text="例如 Ctrl+Alt+V；注册冲突时会保留原快捷键。" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,18" />
        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="记录上限（10～10000 条）" Foreground="{StaticResource Muted}" Margin="0,0,0,7" /><TextBox x:Name="MaxEntriesBox" /></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="普通历史保留天数（1～365）" Foreground="{StaticResource Muted}" Margin="0,0,0,7" /><TextBox x:Name="RetentionBox" /></StackPanel>
        </Grid>
        <TextBlock Text="图片空间上限（20～5000 MB）" Foreground="{StaticResource Muted}" Margin="0,0,0,7" />
        <TextBox x:Name="ImageBudgetBox" />
        <TextBlock Text="收藏保留，但仍计入额度；缩小上限会清理最旧普通记录。" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,18" />
        <TextBlock Text="排除应用（进程名，每行一个）" Foreground="{StaticResource Muted}" Margin="0,0,0,7" />
        <TextBox x:Name="ExcludedBox" AcceptsReturn="True" Height="76" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
        <TextBlock Text="例如 KeePass.exe。仅在可识别复制来源时匹配；未知来源可使用暂停记录。" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,10" />
        <CheckBox x:Name="StartupBox" Content="登录 Windows 时在后台启动" />
        <TextBlock Text="免安装版移动 EXE 后，请重新保存此设置以更新启动路径。" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18" />
        <Border Background="{StaticResource Surface}" CornerRadius="7" Padding="13">
          <StackPanel><TextBlock Text="隐私与数据" FontWeight="SemiBold" /><TextBlock Text="正文、图片和缩略图使用 Windows 当前用户加密，仅保存在本机。日志不包含复制内容。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,7,0,0" /><TextBlock x:Name="DataPathText" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" /><Button Content="开源组件与许可" Click="OnLicenses" Margin="0,10,0,0" HorizontalAlignment="Left" Padding="9,5" /></StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,18,0,0"><TextBlock x:Name="ErrorText" Foreground="#B42318" TextWrapping="Wrap" Margin="0,0,0,10" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Click="OnCancel" Padding="20,9" Margin="0,0,12,0" /><Button x:Name="SaveButton" Content="保存设置" Style="{StaticResource PrimaryButton}" Click="OnSave" Padding="20,9" /></StackPanel>
    </StackPanel>
  </Grid>
</Window>
